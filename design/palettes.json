  "palettes": {
    "pharaoh": {
      "description": "Warm paper canvas, obsidian depth, one acid-lime accent. Adapted from the Pharaoh Terminal System reference. Two deliberate departures from that source, both measured: its `outline` (#757961) sits at 4.28:1 on its own canvas and is darkened here; and its Success/Danger pair (lime #D9FF30, coral #FF5C5C) is NOT adopted — lime reads 1.15:1 as text on white, so a P&L figure in it would be invisible, and making the brand colour also mean profit would strip the number of the meaning colour is carrying. The lime stays a fill; money keeps the shared semantic green and red.",
      "light": {
        "//brand": "A fill, not type. Black on this lime is 14.99:1 — exactly how the reference uses it for its primary pill.",
        "brand": "#D9FF30",
        "onBrand": "#1A1C15",
        "brandContainer": "#ECFFB0",
        "//onBrandContainer": "The readable form of the hue — this is what brand-coloured TEXT resolves to.",
