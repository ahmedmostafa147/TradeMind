rules_version = '2';

// Cloud Firestore access rules for Radar.
//
// Deploy with:  firebase deploy --only firestore:rules
//
// THE ADMIN MODEL
// Admin is membership in the `admins` collection, and that collection is
// writable by NOBODY through this API — `allow write: if false`, no exception.
// The only way to create an admin is by hand in the Firebase Console.
//
// A boolean on the user's own profile would let any signed-up account promote
// itself with a single write. This cannot, because the document that would
// have to be created is unreachable from every client path.
//
// WHAT AN ADMIN CAN AND CANNOT SEE
// An admin reads user PROFILES — email, display name, dates, and the activity
// counters the app maintains. An admin cannot read anybody's trades, their
// watchlist, or their risk settings: those are subcollections OF the profile,
// and a read grant on a document does not reach into its subcollections.
// That is why `capital` is stored one level down instead of on the profile.
//
// That is deliberate, and it is a promise the published privacy policy makes
// in plain words: «قواعد الأمان على السيرفر بتمنع أي مستخدم تاني من قراءتها أو
// تعديلها». Granting trade reads here would make that sentence false, and the
// policy would have to be rewritten and re-disclosed before it could change.
service cloud.firestore {
  match /databases/{database}/documents {

    // Declared inside the match block — a function at file scope, outside
    // `service`, is a syntax error the deploy rejects.
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /// True when the caller's subscription is current — paid and unexpired, or
    /// inside the fourteen-day trial.
    ///
    /// `kTrialDays` in lib/billing/entitlements.dart and TRIAL_DAYS in
    /// site/lib/subscription.ts have to agree with the 14 below. Three copies
    /// of one number is two too many, but a rule cannot import anything.
    function subscription() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)/billing/subscription
      ).data;
    }

    function hasActivePlan() {
      return isSignedIn()
        && exists(
             /databases/$(database)/documents/users/$(request.auth.uid)/billing/subscription
           )
        && (
             (subscription().plan == 'pro'
               && (!('proUntil' in subscription())
                   || subscription().proUntil > request.time))
             || (subscription().plan == 'trial'
                 && subscription().trialStartedAt + duration.value(14, 'd')
                      > request.time)
           );
    }

    // The admin roster. Console-only, by construction.
    //
    // Read is limited to your own document so a client can ask "am I an
    // admin?" without being able to enumerate who else is.
    match /admins/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId} {
      // Owner reads their own profile; an admin reads any, for the dashboard's
      // user list. Nobody else, ever.
      allow read: if isOwner(userId) || isAdmin();

      // The owner writes their own profile, and the shape is pinned. Without a
      // field whitelist a user could attach anything to a document the admin
      // dashboard renders — including markup, or a forged activity counter.
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
             'email', 'displayName', 'createdAt', 'lastSeenAt',
             'platform', 'appVersion', 'tradeCount', 'watchlistCount'
           ])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120;

      allow delete: if isOwner(userId);

      // SUBSCRIPTION STATE. Read by its owner and by an admin; written by
      // almost nobody.
      //
      // WHY THE ADMIN CAN READ THIS AND CANNOT READ ANYTHING ELSE DOWN HERE
      // Trades, the watchlist and the risk rule are the user's own record and
      // the operator has no business in them. A subscription is a contract
      // BETWEEN the user and the operator: activating a payment, extending a
      // trial or answering "why am I locked out" is impossible without seeing
      // it. It carries no portfolio data — a plan name and two dates.
      //
      // The privacy policy had to say so before this shipped, and it does.
      //
      // THE TRIAL CANNOT BE FORGED, AND THAT IS THE WHOLE POINT OF DOING THIS
      // HERE INSTEAD OF IN THE CLIENT.
      //   - A user may CREATE this document exactly once, and only in the trial
      //     shape. Firestore only evaluates `create` when the document does not
      //     exist, so "once" needs no extra check.
      //   - `trialStartedAt` must equal `request.time` — the SERVER's clock at
      //     the moment of the write. A client sending its own timestamp, or a
      //     date in the past to shorten someone else's trial, or in the future
      //     to extend their own, is rejected. This is why the end date is NOT
      //     stored: there is no sentinel for "server time plus fourteen days",
      //     so a stored end date would have to come from the device's clock and
      //     would be trivially editable. The end is computed from this start
      //     plus the constant both clients share.
      //   - Users cannot UPDATE it at all. Upgrading yourself to `pro` is a
      //     write only an admin can make.
      //
      // Delete is allowed to the owner because account deletion must remove
      // everything the account owns — the privacy policy promises that in plain
      // words and test/account_deletion_test.dart guards it. The cost is that
      // deleting your account and signing up again grants a fresh trial; the
      // price of that loophole is your entire journal, which is steep enough.
      match /billing/{docId} {
        allow read: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId)
          && docId == 'subscription'
          && request.resource.data.keys().hasOnly(['plan', 'trialStartedAt'])
          && request.resource.data.plan == 'trial'
          && request.resource.data.trialStartedAt == request.time;

        // Operator-only, and the trial's start is immutable even here: it is
        // evidence of when the clock started, and an admin who needs to give
        // somebody more time sets `proUntil` rather than rewriting history.
        allow update: if isAdmin()
          && request.resource.data.keys().hasOnly([
               'plan', 'trialStartedAt', 'proUntil', 'note'
             ])
          && request.resource.data.plan in ['trial', 'free', 'pro']
          && request.resource.data.trialStartedAt == resource.data.trialStartedAt
          && (!('proUntil' in request.resource.data)
              || request.resource.data.proUntil is timestamp)
          && (!('note' in request.resource.data)
              || (request.resource.data.note is string
                  && request.resource.data.note.size() <= 500));

        allow delete: if isOwner(userId) || isAdmin();
      }

      // Trades and watchlist stay owner-only. An admin is not an owner.
      match /trades/{tradeId} {
        allow read, write: if isOwner(userId);
      }

      match /watchlist/{itemId} {
        allow read, write: if isOwner(userId);
      }

      // The risk rule: capital, the per-trade risk ceiling, and how long an
      // open position may sit before «قرار اليوم» flags it.
      //
      // WHY A SUBCOLLECTION AND NOT THREE FIELDS ON THE PROFILE
      // The profile is the one document an admin is allowed to read. Capital is
      // the single most sensitive number a trader has — it is their portfolio
      // size — and putting it there would hand every user's net position to the
      // operator, silently, as a side effect of a sync feature. It would also
      // make the privacy policy's «الأدمن بيشوف ملفات التعريف والعدّادات بس»
      // false, which is a sentence that has to be rewritten and re-disclosed
      // before it can change. Down here the rule is the same one trades get:
      // owner, and nobody else, ever.
      //
      // These lived in local Hive settings on the phone and in localStorage in
      // the browser, so the same trade scored differently on each — the
      // discipline score's "risk within limit" component and every over-risk
      // warning divide by capital, so two numbers meant two verdicts and no way
      // to tell which was right.
      //
      // Ranges, not just types. A zero or negative capital turns every figure
      // on both dashboards into Infinity or a sign-flipped lie. The ceiling is
      // deliberately absurd rather than tight: it rejects garbage without
      // second-guessing a real portfolio.
      //
      // `is number` rather than `is int` for the day count on purpose — the two
      // SDKs disagree about whether a whole number serialises as an integer or
      // a double, and `is int` would turn that disagreement into a silent
      // permission denial on save. Both readers coerce to a whole number.
      match /settings/{settingsId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
               'capital', 'maxRiskPercent', 'waitingThresholdDays'
             ])
          && (!('capital' in request.resource.data)
              || (request.resource.data.capital is number
                  && request.resource.data.capital > 0
                  && request.resource.data.capital <= 1000000000000))
          && (!('maxRiskPercent' in request.resource.data)
              || (request.resource.data.maxRiskPercent is number
                  && request.resource.data.maxRiskPercent > 0
                  && request.resource.data.maxRiskPercent <= 1))
          && (!('waitingThresholdDays' in request.resource.data)
              || (request.resource.data.waitingThresholdDays is number
                  && request.resource.data.waitingThresholdDays >= 1
                  && request.resource.data.waitingThresholdDays <= 3650));
      }
    }

    // What the admin publishes and every signed-in user reads.
    //
    // Read requires a session rather than being public: this is a product
    // surface, not a marketing page, and an open read would let anyone scrape
    // the whole feed without ever installing anything.
    // THERE WERE `announcements` AND `signals` COLLECTIONS HERE. Both are gone,
    // and neither is replaced — they fall through to the catch-all below, which
    // denies them outright, so documents still sitting in either are unreadable
    // by every client rather than merely unrendered.
    //
    // `announcements` was a broadcast feed from the operator to every user. It
    // is gone by the owner's decision: the product is a market and journal
    // tool, not a channel, and nothing was ever published through it.
    //
    // `signals` carried operator-published trade ideas — a ticker with an entry
    // price and a stop. The product says the opposite in three published places
    // (the site footer disclaimer, the terms, and the FAQ answer to «التطبيق
    // بيقولي أشتري إيه؟»), RELEASE.md depends on that claim so Play does not
    // file the app under its restricted financial categories, and handing out
    // tickers carries the FRA licensing exposure this project already decided
    // against.
    //
    // A READER MUST NEVER OUTLIVE ITS RULE. When `signals` was removed, both
    // clients still fetched the two collections in one Promise.all /
    // Future.wait, and both swallow a rejection into an empty list — so a
    // denial on one would have taken the announcements feed down with it,
    // silently. Whatever replaces these, remove the fetch and the rule in the
    // same change.
    //
    // Do not add `signals` back without changing the legal pages FIRST.

    // EGX investor flows — who bought and who sold, by nationality and by
    // investor class. One document per session, keyed YYYY-MM-DD.
    //
    // This is PUBLIC MARKET DATA the exchange publishes to everyone, so it is
    // not owned by any user and carries nothing private. Read still requires a
    // session for the same reason the old feed did: it is a product surface,
    // and an open read would let anyone scrape the accumulated history without
    // ever signing up. The history is the part that took time to gather.
    //
    // Writes are admin-only. The refresh runs in the admin's own browser
    // against /api/egx-flows, so the write arrives with the admin's
    // credentials and needs no service account — which is why there is no
    // server identity anywhere in this file.
    //
    // The shape is pinned like the profile is. Without a whitelist an admin
    // account could park arbitrary fields on a document every signed-in user
    // renders.
    // WHICH PAID FEATURES CAN ACTUALLY BE ENFORCED HERE, AND WHICH CANNOT
    //
    // Only one of the four things the paid plan sells is data WE hold, and it
    // is this one — so this is the only one a rule can defend. The others are
    // client-side gates and nothing more, which is not a gap being hidden:
    //
    //   • «الأداء» and «التحليلات» are computed on the device from the user's
    //     own trades. There is no request to authorise; the numbers never
    //     leave the machine that made them. A rule cannot reach this and never
    //     will.
    //   • The AI reader runs on the USER'S own Gemini key and bills them, not
    //     us. Gating it protects no cost of ours.
    //   • Closing prices come through /api/quote, which takes no credential
    //     today. Locking it needs the route to verify a Firebase ID token,
    //     which needs firebase-admin and a service account — deliberately not
    //     in this project yet. Written down as owed rather than assumed done.
    match /marketFlows/{sessionDate} {
      // A SESSION IS NO LONGER ENOUGH. This is the accumulated history the
      // pricing page sells, and a client flag is the wrong place to defend it:
      // the browser's copy of that flag is editable in a console, and the app's
      // is editable in an APK.
      //
      // The trial counts, and it is computed the same way both clients compute
      // it — the stored start plus fourteen days — so a document with no
      // `proUntil` and a fresh start reads as full access here exactly as it
      // does on screen. Costs one document read per query, which is the price
      // of the rule meaning anything.
      // The admin is exempt: they publish this data by hand from the console
      // and have to see what is already there, and requiring the operator to
      // subscribe to their own product is a way to lock yourself out.
      allow read: if isAdmin() || (isSignedIn() && hasActivePlan());
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
             'date', 'scope', 'all', 'institutions', 'individuals',
             'fetchedAt', 'source'
           ])
        && request.resource.data.date is string
        && request.resource.data.date.size() <= 10;
      allow delete: if isAdmin();
    }

    // Anything not matched above is denied, including any path a future
    // version adds before its rule does.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
