# --- server ----------------------------------------------------------------
NODE_ENV=production
PORT=3010
LOG_LEVEL=info

# --- primary provider ------------------------------------------------------
# The response mapping in egx-api.provider.ts is UNVERIFIED — EGXAPI's docs were
# unreachable when it was written. Check mapQuote/mapCandle against the real
# schema before trusting production traffic to it.
EGX_API_KEY=
EGX_BASE_URL=https://api.egxapi.com
# Leave empty to disable streaming and let the poller pull instead.
EGX_WS_URL=

# --- fallback provider -----------------------------------------------------
# Empty uses Yahoo's chart endpoint (last daily close, unofficial). Point this
# at the scraper or an internal API when one exists.
FALLBACK_BASE_URL=
FALLBACK_ENABLED=true

# Pins the chain to one provider during an incident. Empty = normal order.
ACTIVE_PROVIDER=

# --- cache -----------------------------------------------------------------
# Empty falls back to an in-process map. The service still serves.
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=86400

# --- timing ----------------------------------------------------------------
POLL_INTERVAL_MS=15000
HEALTH_CHECK_INTERVAL_MS=30000
REQUEST_TIMEOUT_MS=8000
FAILURE_THRESHOLD=3
LATENCY_THRESHOLD_MS=5000
MAX_RETRIES=2
RETRY_BASE_DELAY_MS=250

# --- what to poll ----------------------------------------------------------
TRACKED_SYMBOLS=COMI,TMGH,SWDY,EAST,ABUK,HRHO,ETEL,EKHO,ORWE,AMOC

# --- security --------------------------------------------------------------
CORS_ORIGINS=*
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
# Empty disables the key check. Closing prices are public data.
SERVICE_API_KEY=
