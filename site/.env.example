# The site's public origin, with no trailing slash.
#
# Required for any real build. It becomes the canonical <link> on every page,
# the URLs inside sitemap.xml, and the absolute og:image that social platforms
# fetch when someone shares a link — none of which can be relative.
#
# Copy this file to .env.local for local work, or pass it inline when building:
#   NEXT_PUBLIC_SITE_URL=https://your-domain.com npm run build
NEXT_PUBLIC_SITE_URL=http://localhost:3000
