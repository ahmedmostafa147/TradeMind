{
  "name": "tradepilot-site",
  "version": "1.0.0",
  "private": true,
  "description": "Public site for TradePilot — landing page and legal pages.",
  "scripts": {
    "dev": "next dev --port 3000",
    "theme": "node ../tool/gen-theme.mjs",
    "theme:check": "node ../tool/gen-theme.mjs --check",
    "//build": "theme:check gates the build so a deploy can never ship CSS tokens that no longer match design/palettes.json — the app and the site would drift apart silently otherwise.",
    "build": "npm run theme:check && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.1.14",
    "ttf2woff2": "^8.0.1",
    "typescript": "5.9.2"
  }
}
