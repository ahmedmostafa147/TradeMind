<?xml version="1.0" encoding="utf-8"?>
<!--
  The launch mark: a radar scope, for an app called Radar.

  DRAWN, NOT PHOTOGRAPHED. assets/logo.png is a 1024px JPEG whose artwork still
  reads "TradeMind" — the name the app was renamed away from in f776f16 — and
  being a JPEG it has no alpha, so it would land on any splash as an opaque
  rectangle with the wrong product name inside it. A vector costs 1 KB, scales
  to every density, tints with the brand, and says the right thing.

  Sized on Android 12's 240dp canvas. The system masks that down to a 160dp
  circle, so nothing may reach the edge: the outer ring stops at r=52 inside a
  108-unit viewport, which keeps the whole mark inside the safe area on every
  launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Two rings and a sweep. Lime on charcoal is the palette's own pairing:
         brand is a background colour everywhere else in this product, and this
         is the one surface where it is the ink instead — on a field dark
         enough (#121417) to carry it at 12:1. -->
    <path
        android:strokeColor="#D9FF30"
        android:strokeWidth="2.5"
        android:strokeAlpha="0.35"
        android:fillColor="#00000000"
        android:pathData="M54,2 A52,52 0 1,1 53.9,2" />
    <path
        android:strokeColor="#D9FF30"
        android:strokeWidth="2.5"
        android:strokeAlpha="0.55"
        android:fillColor="#00000000"
        android:pathData="M54,20 A34,34 0 1,1 53.9,20" />
    <path
        android:strokeColor="#D9FF30"
        android:strokeWidth="2.5"
        android:strokeAlpha="0.75"
        android:fillColor="#00000000"
        android:pathData="M54,38 A16,16 0 1,1 53.9,38" />

    <!-- The sweep line, up and to the right: the same direction the equity
         curve runs when the journal is doing its job. -->
    <path
        android:strokeColor="#D9FF30"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,54 L90,26" />

    <!-- The contact. Filled, so it reads as a found thing rather than another
         ring. -->
    <path
        android:fillColor="#D9FF30"
        android:pathData="M90,26 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0" />
</vector>
